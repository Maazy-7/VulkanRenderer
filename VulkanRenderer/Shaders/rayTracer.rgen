#version 460

#extension GL_EXT_ray_tracing : require

//descriptor set owned by vulkan rendering backend, a per frame set for frame data
layout (set = 0, binding = 0) uniform UniformBufferObject
{
    mat4 view;
    mat4 proj;
    mat4 lightSpaceMat;
    vec4 viewPos;
    vec4 lightPos;
} ubo;

//set 1 descriptor to be used in reflection shader for texture sampling as gbuffers wont be useful there

//descriptor set owned by ray tracer
layout (set = 2, binding = 0) uniform accelerationStructureEXT tlas;
layout (set = 2, binding = 1, rgba16f) uniform image2D outputImage;
layout (set = 2, binding = 3) uniform sampler2D gDepth;
layout (set = 2, binding = 4) uniform sampler2D gNormalMetallic;
layout (set = 2, binding = 5) uniform sampler2D gAlbedoRoughness;

layout (push_constant) uniform pushConstants 
{
    mat4 InvViewProjMat;
    layout (offset = 64) vec4 backgroundColor;
} matrix;

layout (location = 0) rayPayloadEXT vec3 reflectionColor;
layout (location = 1) rayPayloadEXT float shadowVisibility;

vec4 getPositionFromDepthMap(vec2 uv);


float hash21(vec2 p) 
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

vec3 randomOnUnitSphere(vec2 uv) 
{
    float u = hash21(uv + vec2(1.0, 0.0));
    float v = hash21(uv + vec2(0.0, 2.0));
    
    float theta = u * 2.0 * 3.14159265359;
    float phi = acos(2.0 * v - 1.0);
    
    return vec3(cos(theta) * sin(phi), sin(theta) * sin(phi), cos(phi));
}


void main() 
{
	ivec2 pixelCoords = ivec2(gl_LaunchIDEXT.xy);
	vec2 uv = vec2(pixelCoords) / vec2(gl_LaunchSizeEXT.xy);

    //early exit detects if depth map is super far, which will most likely be empty space thus exiting early and skipping and trace ray calls
    vec4 worldPos = getPositionFromDepthMap(uv);
    if (worldPos.w > 0.9999) 
    {
        imageStore(outputImage, pixelCoords, vec4(1, matrix.backgroundColor.xyz));//1 for the shadow and gba channels hold sky/background color to be used in the blending pass
        return;
    }

    vec4 normalMetallic = texture(gNormalMetallic, uv).xyzw; 
    vec3 normal = normalize(normalMetallic.xyz);
    float metallic = normalMetallic.w;

    vec4 albedoRoughness = texture(gAlbedoRoughness, uv).xyzw;
    vec3 albedo = albedoRoughness.xyz;
    float roughness = albedoRoughness.w;

    vec3 rayOrigin = worldPos.xyz + normal * 0.001;//slight shift in ray origin to reduce ray acne (self intersection of ray with surface it came from)
    vec3 randomDir = randomOnUnitSphere(vec2(pixelCoords)) * 0.1;//random offset to light position so it simulates an area light
    vec3 lightDirection = normalize((ubo.lightPos.xyz + randomDir) - worldPos.xyz);

    //compute and trace shadow ray
    uint shadowRayFlags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT;
    float tMin = 0.001;
    float tMax = 10000.0;

    //intializing both payloads before beginning tracing
    shadowVisibility = 0.0;
    reflectionColor = vec3(0.0);

    traceRayEXT(tlas, shadowRayFlags, 0xFF, 0, 0, 1, rayOrigin, tMin, lightDirection, length(ubo.lightPos.xyz - rayOrigin), 1);
    float shadow = shadowVisibility;//shadow ray traced result stored here, if ray intersects something 0 is returned meaning shadow otherwise miss returns 1

    //compute and trace reflection result
    vec3 reflectionResult = vec3(0.0);
    if (roughness < 0.05)//only tracing reflection rays on reflective materials (reflective materials are very smooth and have roughness less than 0.05) 
    {
        vec3 viewDirection = normalize(ubo.viewPos.xyz - worldPos.xyz);
        vec3 reflectDirection = reflect(-viewDirection, normal);

        uint reflectionRayFlags = gl_RayFlagsOpaqueEXT;
        traceRayEXT(tlas, reflectionRayFlags, 0xFF, 0, 0, 0, rayOrigin, tMin, reflectDirection, tMax, 0);
        reflectionResult = reflectionColor;
    }
    
    //compute final color
    /*vec3 ambient = vec3(0.3) * albedo * (1.0 - metallic);//ambient color
    vec3 diffuse = albedo * shadow + ambient;
    vec3 color = mix(diffuse, reflectionResult, metallic);//weighting diffuse and reflection based of metalness of surface
    //gamma correction
    color = color / (color + 1.0);
    color = pow(color, vec3(1.0/2.2));*/

    //store shadow and reflection as a singular vec4 for blending with rasterized output
    vec4 rtShadowAndReflection = vec4(shadow, reflectionColor);
    imageStore(outputImage, pixelCoords, rtShadowAndReflection);
}

vec4 getPositionFromDepthMap(vec2 uv)//worldPos.w stores the depth to check for early exit
{
    float depth = texture(gDepth, uv).r;
    vec4 ndcPos = vec4(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = matrix.InvViewProjMat * ndcPos;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;
    return vec4(worldPos, depth);
}